# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase project anon/public key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AES key used by the password manager (required for that feature)
VITE_CRYPTO_KEY=your-crypto-key-here

# Note: Service role key is NOT needed for frontend
# It's automatically available in Edge Functions
